{
  "name": "varbase-project",
  "description": "Varbase project is a composer starterkit for new projects.",
  "license": "GPL-2.0-or-later",
  "private": true,
  "engines": {
    "yarn": ">= 4.18.1",
    "node": ">= 24.0"
  },
  "scripts": {
    "storybook:generate-all-stories": "drush storybook:generate-all-stories --force",
    "storybook:gen": "drush storybook:generate-all-stories --force",
    "storybook:gen-new": "drush storybook:generate-all-stories",
    "storybook:dev": "npx kill-port --port 6006; npx storybook dev --disable-telemetry -p 6006",
    "storybook:build": "npx storybook build --disable-telemetry --output-dir storybook",
    "storybook:kill": "npx kill-port --port 6006;",
    "storybook": "storybook:dev",
    "build-storybook": "storybook:build",
    "phpcs": "phpcs --standard=./.phpcs.xml .",
    "phpcbf": "phpcbf --standard=./.phpcs.xml .",
    "lint:yaml": "node ./node_modules/eslint/bin/eslint.js --config=.eslintrc.json --ext .yml .",
    "lint:js": "node ./node_modules/eslint/bin/eslint.js --config=.eslintrc.json --ext .js .",
    "lint:css": "npx stylelint --config=.stylelintrc.json",
    "drupal-libraries-sync": "node ./docroot/profiles/contrib/varbase/scripts/drupal-libraries-sync.js",
    "postinstall": "node ./docroot/profiles/contrib/varbase/scripts/drupal-libraries-sync.js",
    "test": "node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js",
    "test:chromium": "BROWSER=chromium node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js",
    "test:firefox": "BROWSER=firefox node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js",
    "test:webkit": "BROWSER=webkit node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js",
    "test:headed": "HEADLESS=false node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js",
    "test:fast": "SLOW_MO=0 node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js",
    "generate-reports": "node ./node_modules/@vardot/varbase-e2e/bin/generate-reports.js"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-media-embed": "^45.2.0",
    "ace-builds": "^1.0.0",
    "aos": "^2.0.0",
    "blazy": "^1.0.0",
    "dropzone": "^5.0.0",
    "jquery.fancytree": "^2.0.0",
    "slick-carousel": "^1.0.0",
    "swagger-ui-dist": "^3.0.0"
  },
  "drupal-libraries": {
    "library-directory": "docroot/libraries",
    "libraries": [
      {
        "name": "ckeditor5/plugins/media-embed",
        "package": "@ckeditor/ckeditor5-media-embed"
      },
      {
        "name": "ace",
        "package": "ace-builds"
      },
      {
        "name": "aos",
        "package": "aos"
      },
      {
        "name": "blazy",
        "package": "blazy"
      },
      {
        "name": "dropzone",
        "package": "dropzone/dist"
      },
      {
        "name": "jquery.fancytree",
        "package": "jquery.fancytree"
      },
      {
        "name": "slick/slick",
        "package": "slick-carousel/slick"
      },
      {
        "name": "swagger-ui/dist",
        "package": "swagger-ui-dist"
      }
    ]
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.4",
    "@storybook/addon-a11y": "^8.0.0",
    "@storybook/addon-essentials": "^8.0.0",
    "@storybook/addon-links": "^8.0.0",
    "@storybook/addon-webpack5-compiler-swc": "^2.1.0",
    "@storybook/blocks": "^8.0.0",
    "@storybook/builder-webpack5": "^8.0.0",
    "@storybook/cli": "^8.0.0",
    "@storybook/components": "^8.0.0",
    "@storybook/core-events": "^8.0.0",
    "@storybook/manager-api": "^8.0.0",
    "@storybook/preview-api": "^8.0.0",
    "@storybook/react": "^8.0.0",
    "@storybook/server": "^8.0.0",
    "@storybook/server-webpack5": "^8.0.0",
    "@storybook/test": "^8.6.0",
    "@storybook/theming": "^8.0.0",
    "@storybook/types": "^8.0.0",
    "@vardot/varbase-e2e": "^2.0.4",
    "eslint": "^8.0.0",
    "eslint-plugin-storybook": "^0.11.3",
    "fork-ts-checker-webpack-plugin": "^9.0.0",
    "jquery": "^3.7.0",
    "prettier": "^2.1.2",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "storybook": "^8.0.0",
    "storybook-addon-root-attributes": "^2.0.0",
    "stylelint": "^16.0.0",
    "stylelint-checkstyle-formatter": "^0.1.2",
    "stylelint-order": "^6.0.0",
    "typescript": "^5.0.0",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0"
  },
  "resolutions": {
    "webpack": "^5",
    "@cucumber/cucumber": "12.9.0",
    "@cucumber/pretty-formatter": "1.0.1"
  },
  "packageManager": "yarn@4.18.1"
}
